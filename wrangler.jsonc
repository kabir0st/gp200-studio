{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gp200-studio",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "kabirtamari.com/gp200studio*",
      "zone_name": "kabirtamari.com"
    }
  ]
}
