{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gp200-studio",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Public message wall (see worker/index.js /api/* routes + migrations/).
  // Fill database_id from `wrangler d1 create gp200-forum` before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gp200-forum",
      "database_id": "REPLACE_WITH_ID_FROM_WRANGLER_D1_CREATE"
    }
  ],
  "routes": [
    {
      "pattern": "kabirtamari.com/gp200studio*",
      "zone_name": "kabirtamari.com"
    },
    // Legacy domain, kept attached so the Worker can 301 it to the new home.
    {
      "pattern": "gp200.afterhour.uk",
      "custom_domain": true
    }
  ]
}
